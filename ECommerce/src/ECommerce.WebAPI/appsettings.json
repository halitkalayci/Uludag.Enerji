{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TokenOptions": {
    "Issuer": "Uludag.ECommerce",
    "Audience": "Uludag.ECommerce.Client",
    "AccessTokenExpiration": 60,
    "RefreshTokenExpiration": 3
  },
  "RedisOptions": {
    "InstanceName": "uludag:"
  },
  "RateLimitOptions": {
    "Capacity": 10,
    "LeakIntervalSeconds": 12,
    "Whitelist": [ "/swagger", "/openapi" ]
  },
  "MultiFactorOptions": {
    "Issuer": "Uludag ECommerce",
    "SessionExpiration": 10,
    "VerificationWindow": 1,
    "MaxVerificationAttempts": 5,
    "LockoutDuration": 15
  }
}
